# `npm run build:everything` stages a full copy of lineage/ here before zipping it.
# The release ZIP beside it IS committed; the staging directory is a duplicate of
# the tree and must not be.
/release/lineage_v*/

# Installed dependencies are reproducible from the lockfile.
node_modules/

# Machine-local Claude Code settings: per-developer allow-rules that accumulate
# local paths, ports, PIDs and one-off commands. Nothing here belongs in a tree
# that gets moved to another project. Shared settings go in .claude/settings.json.
.claude/settings.local.json
