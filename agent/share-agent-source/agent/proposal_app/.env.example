# このファイルを同じディレクトリに `.env` としてコピーして使います（ローカル実行用）。
# Cloud Run では .env は使わず、デプロイ時に環境変数を直接設定します。

# --- Vertex AI (本物の Gemini) を使う設定 ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# --- モデル ---
# 実在するモデルIDに合わせて調整してください（例: gemini-3.5-flash / gemini-3.5-pro）。
GEMINI_MODEL=gemini-3.5-flash

# --- （任意）簡易パスワード ---
# 設定するとサイト全体に HTTP Basic 認証がかかります（公開時の無断利用防止）。
# ローカルでは未設定でOK。
# APP_PASSWORD=your-strong-password
